{
    "name": "shetabit/extractor",
    "type": "library",
    "description": "a `micro client` generator to communicate between `micro services` in laravel apps",
    "keywords": [
        "shetabit",
        "extractor",
        "api extractor",
        "api client",
        "api remote client",
        "micro service",
        "micro service client",
        "micro service data extractor",
        "remote micro service"
    ],
    "homepage": "https://github.com/shetabit/extractor",
    "license": "MIT",
    "authors": [
        {
            "name": "Mahdi Khanzadi",
            "email": "khanzadimahdi@gmail.com",
            "homepage": "https://github.com/shetabit",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8.2|^8.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "orchestra/testbench": "^10.0|^11.0",
        "phpcsstandards/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Shetabit\\Extractor\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shetabit\\Extractor\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "check-style": "phpcs",
        "fix-style": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G",
        "rector": "rector process --dry-run",
        "ci": [
            "@check-style",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shetabit\\Extractor\\Providers\\ExtractorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts-descriptions": {
        "test": "Run the test suite.",
        "test-coverage": "Run the test suite and report code coverage.",
        "check-style": "Check the coding style of src and tests.",
        "fix-style": "Fix the coding style of src and tests where possible.",
        "analyse": "Run static analysis on src and tests.",
        "rector": "Show the refactorings Rector would apply.",
        "ci": "Run every check the CI pipeline runs."
    }
}
