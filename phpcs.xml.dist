<?xml version="1.0"?>
<ruleset name="Extractor">
    <description>The coding standard of the extractor package.</description>

    <file>src</file>
    <file>tests</file>

    <!-- Show progress and sniff codes, and colorize the output. -->
    <arg name="colors"/>
    <arg value="ps"/>

    <!-- The soft limit on the line length is a warning, it must not fail the build. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <rule ref="PSR2"/>

    <!-- The stub server of the test suite is a script, not a class. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/Support/server/*</exclude-pattern>
    </rule>
</ruleset>
